# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!/.env.example


# Monorepo: keep local installs, build output and credentials out of Git
**/node_modules/
**/.next/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.auth-integration-state.json
**/*.pyc
**/.env
**/.env.*
!**/.env.example

.agents/
/.opencode
opencode.json
AGENTS.md

# Local BE2 notes
/docs/BE2_IMPLEMENTATION_REPORT.md
/docs/BE2_WORKLOG.md
