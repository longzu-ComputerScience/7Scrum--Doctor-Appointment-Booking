# Browser-safe Supabase settings for Patient/Doctor authentication and authorized realtime.
# Never use a service-role key here. Registration/profile/business writes go through /api.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Next.js server-side rewrite target (Render FastAPI ORIGIN, no /api suffix).
# Local dev: http://127.0.0.1:8000
# Vercel Production: set BACKEND_URL to your real HTTPS Render service URL
# in Vercel Project Settings > Environment Variables. Never put secrets here.
BACKEND_URL=http://127.0.0.1:8000
